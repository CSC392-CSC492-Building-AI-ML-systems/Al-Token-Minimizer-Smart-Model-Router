GEMINI_API_KEY=your-key-here
# only needed for the benchmark's Jev grading (https://openrouter.ai/keys)
OPEN_ROUTER_KEY=your-key-here

# none: baseline; light: concise answers; code: fenced Python/JS; full: both
COMPRESSION_LEVEL=none
# Requests opt in with cache="use" or cache="refresh". Global kill switch:
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=256
CACHE_TTL_SECONDS=300
