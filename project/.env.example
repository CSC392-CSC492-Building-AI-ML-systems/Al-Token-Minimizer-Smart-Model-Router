GEMINI_API_KEY=your-key-here
# only needed for the benchmark's Jev grading (https://openrouter.ai/keys)
OPEN_ROUTER_KEY=your-key-here

# none: baseline; light: concise answers; code: fenced Python/JS; full: both
COMPRESSION_LEVEL=none
# Requests opt in with cache="use" or cache="refresh". CACHE_ENABLED=false
# turns off both caches; the other two turn off one each.
CACHE_ENABLED=true
EXACT_CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
CACHE_MAX_ENTRIES=256
CACHE_TTL_SECONDS=300
# semantic cache (docker compose up -d), leave out for the default
# REDIS_URL=redis://localhost:6379
# how long semantic cache entries last, in seconds (default 18000, 5 hours)
SEMANTIC_CACHE_TTL_SECONDS=18000
# how close in meaning a question must be for a semantic hit: cosine distance,
# 0 = same meaning only, higher = looser (default 0.1)
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.1
